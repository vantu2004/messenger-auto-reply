<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main" android:fillViewport="true"
    android:clipToPadding="false" android:overScrollMode="always"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:paddingBottom="32dp">

        <!-- ==================== HERO: Master Toggle ==================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <!-- Glow effect behind -->
            <View android:id="@+id/view_glow"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_hero_glow_off"/>

            <!-- Hero Card -->
            <LinearLayout android:id="@+id/card_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/hero_min_height"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_glass_card"
                android:padding="24dp">

                <!-- Status text -->
                <TextView android:id="@+id/tv_hero_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bot đã tắt"
                    android:textSize="20sp"
                    android:textColor="@color/glass_red"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="16dp"/>

                <!-- Large Toggle Switch -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_master"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:minHeight="40dp"
                    android:scaleX="1.5"
                    android:scaleY="1.5"
                    app:trackTint="@color/glass_toggle_off"
                    app:thumbTint="@color/white"
                    android:layout_marginBottom="16dp"/>

                <!-- Subtitle hint -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap để bật/tắt nhanh"
                    android:textSize="12sp"
                    android:textColor="@color/glass_text_dim"
                    android:layout_marginBottom="12dp"/>

                <!-- Compact status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE"
                        android:textSize="11sp"
                        android:textColor="@color/glass_text_secondary"
                        android:fontFamily="monospace"/>

                    <View android:layout_width="1dp" android:layout_height="12dp"
                        android:background="@color/glass_text_dim"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView android:id="@+id/tv_last_order"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="11sp"
                        android:textColor="@color/glass_text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"/>

                    <TextView android:id="@+id/tv_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="11sp"
                        android:textColor="@color/glass_green"
                        android:fontFamily="monospace"/>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- ==================== CONFIG: Group + Reply + Name ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="@dimen/glass_padding"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NHÓM CHAT" android:textSize="@dimen/text_label"
                android:textColor="@color/glass_text_secondary"
                android:textStyle="bold" android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_group_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/input_min_height"
                android:hint="Tên nhóm (VD: Test giao đơn)"
                android:inputType="text" android:background="@drawable/bg_input_glass"
                android:paddingHorizontal="14dp" android:textSize="14sp"
                android:textColor="@color/glass_text_primary"
                android:textColorHint="@color/glass_text_dim"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/glass_input_border" android:layout_marginVertical="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NỘI DUNG TỰ REPLY" android:textSize="@dimen/text_label"
                android:textColor="@color/glass_text_secondary"
                android:textStyle="bold" android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_reply_text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/input_min_height"
                android:hint="VD: nhận"
                android:inputType="text" android:background="@drawable/bg_input_glass"
                android:paddingHorizontal="14dp" android:textSize="14sp"
                android:textColor="@color/glass_text_primary"
                android:textColorHint="@color/glass_text_dim"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/glass_input_border" android:layout_marginVertical="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TÊN MESSENGER CỦA BẠN" android:textSize="@dimen/text_label"
                android:textColor="@color/glass_text_secondary"
                android:textStyle="bold" android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="(bot dùng để không reply vào tin mình)"
                android:textSize="11sp" android:textColor="@color/glass_text_dim"
                android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_my_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/input_min_height"
                android:hint="VD: An" android:inputType="textPersonName"
                android:background="@drawable/bg_input_glass"
                android:paddingHorizontal="14dp" android:textSize="14sp"
                android:textColor="@color/glass_text_primary"
                android:textColorHint="@color/glass_text_dim"/>
        </LinearLayout>

        <!-- ==================== ALLOWED SENDERS ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="@dimen/glass_padding"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CHỈ REPLY TỪ" android:textSize="@dimen/text_label"
                android:textColor="@color/glass_text_secondary"
                android:textStyle="bold" android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_sender_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(để trống = reply tất cả mọi người)"
                android:textSize="12sp" android:textColor="@color/glass_text_dim"
                android:layout_marginBottom="8dp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_senders"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText android:id="@+id/et_new_sender" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:minHeight="44dp"
                    android:layout_weight="1"
                    android:hint="VD: Jerry Nguyễn" android:inputType="textPersonName"
                    android:background="@drawable/bg_input_glass" android:paddingHorizontal="14dp"
                    android:textSize="13sp"
                    android:textColor="@color/glass_text_primary"
                    android:textColorHint="@color/glass_text_dim"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_sender"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="44dp" android:layout_marginStart="8dp" android:text="Thêm"
                    android:textSize="13sp" app:cornerRadius="12dp"
                    app:backgroundTint="@color/glass_accent"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== KEYWORD SETS ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="@dimen/glass_padding"
            android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="BỘ KEYWORD"
                    android:textSize="@dimen/text_label" android:textColor="@color/glass_text_secondary"
                    android:textStyle="bold" android:letterSpacing="0.1"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_set"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="+ Tạo bộ" android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/glass_card"
                    android:textColor="@color/glass_accent"
                    app:strokeColor="@color/glass_accent"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_sets"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ==================== FOOTER ACTIONS ==================== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_logs"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="44dp" android:layout_marginEnd="6dp"
                android:text="Logs" android:textSize="12sp" app:cornerRadius="12dp"
                app:backgroundTint="@color/glass_card"
                android:textColor="@color/glass_text_secondary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_backup_restore"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="44dp" android:layout_marginStart="6dp"
                android:text="Sao lưu" android:textSize="12sp" app:cornerRadius="12dp"
                app:backgroundTint="@color/glass_card"
                android:textColor="@color/glass_text_secondary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
