<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Tên bộ keyword" android:textSize="13sp" android:textColor="#78909C"
        android:layout_marginBottom="8dp"/>

    <EditText android:id="@+id/et_set_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="@dimen/input_min_height"
        android:hint="VD: Khu vực A, Ca sáng..."
        android:inputType="text" android:background="#808080"
        android:paddingHorizontal="12dp" android:textSize="14sp"/>
</LinearLayout>
