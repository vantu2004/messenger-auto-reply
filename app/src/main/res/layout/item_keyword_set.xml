<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/bg_set_item"
    android:layout_marginBottom="8dp">

    <RadioButton android:id="@+id/radio_set"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:buttonTint="@color/glass_accent" android:layout_marginEnd="10dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_set_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/glass_text_primary"/>
        <TextView android:id="@+id/tv_set_count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/glass_text_secondary" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <ImageButton android:id="@+id/btn_edit_set"
        android:layout_width="40dp" android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/glass_accent"/>
        
    <ImageButton android:id="@+id/btn_del_set"
        android:layout_width="40dp" android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/glass_red"/>
</LinearLayout>
