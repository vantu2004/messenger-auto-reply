<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:overScrollMode="always" android:fillViewport="false"
    android:fadeScrollbars="false" android:scrollbars="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <!-- Tên bộ -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TÊN BỘ" android:textSize="11sp" android:textColor="#78909C"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_set_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#808080"
            android:inputType="text"
            android:minHeight="@dimen/input_min_height"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Keywords kích hoạt -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="KEYWORD KÍCH HOẠT" android:textSize="11sp" android:textColor="#1565C0"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>

        <!-- ★ FIX: Dùng FlexboxLayout thay RecyclerView — tránh bug measure trong NestedScrollView -->
        <com.google.android.flexbox.FlexboxLayout android:id="@+id/flex_kw"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:flexDirection="row"
            app:flexWrap="wrap"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_add_kw"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="#808080"
                android:gravity="center_vertical"
                android:hint="Thêm keyword..."
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_kw"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+"
                android:textSize="18sp"
                app:backgroundTint="#1565C0" />

        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#ECEFF1" android:layout_marginBottom="16dp"/>

        <!-- Excludes -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="KEYWORD LOẠI TRỪ (không reply nếu chứa)" android:textSize="11sp"
            android:textColor="#E53935" android:textStyle="bold" android:layout_marginBottom="6dp"/>

        <!-- ★ FIX: Dùng FlexboxLayout thay RecyclerView -->
        <com.google.android.flexbox.FlexboxLayout android:id="@+id/flex_ex"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:flexDirection="row"
            app:flexWrap="wrap"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_add_ex"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="#808080"
                android:gravity="center_vertical"
                android:hint="VD: hủy, test, fake..."
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_ex"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+"
                android:textSize="18sp"
                app:backgroundTint="#E53935" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
